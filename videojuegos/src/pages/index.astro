---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import SearchForm from '../components/SearchForm.astro';
import { supabase } from '../lib/supabase';

type Juego = {
  id: number;
  nombre: string;
  imagen: string;
  categoria: string;
};

const PAGE_SIZE = 6;

const url = Astro.url;
const q = url.searchParams.get('q') ?? '';
const page = Number(url.searchParams.get('page') ?? '1');

const from = (page - 1) * PAGE_SIZE;
const to = from + PAGE_SIZE - 1;

let query = supabase
  .from('juegos')
  .select('*', { count: 'exact' })
  .order('id', { ascending: true })
  .range(from, to);

if (q) {
  query = query.ilike('nombre', `%${q}%`);
}

const { data, count, error } = await query;
const juegos = data as Juego[] | null;
if (error) {
  console.error('Error de Supabase:', error);
}

const total = count ?? 0;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
---

<Layout title="Catálogo" description="Explora el catálogo de videojuegos.">
  <h1>Catálogo de Videojuegos</h1>

  <SearchForm action="/" value={q} placeholder="Buscar por nombre..." />

  {error && <p>Ocurrió un error cargando los juegos.</p>}

  <div class="game-grid">
    {juegos?.map((juego) => (
      <GameCard nombre={juego.nombre} categoria={juego.categoria} imagen={juego.imagen} />
    ))}
  </div>

  {juegos?.length === 0 && <p>No se encontraron juegos.</p>}

  <nav class="pagination" aria-label="Paginación de resultados">
    {page > 1 && (
      <a href={`/?q=${encodeURIComponent(q)}&page=${page - 1}`}>← Anterior</a>
    )}
    <span>Página {page} de {totalPages}</span>
    {page < totalPages && (
      <a href={`/?q=${encodeURIComponent(q)}&page=${page + 1}`}>Siguiente →</a>
    )}
  </nav>
</Layout>

<style>
  .game-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .pagination {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: center;
    color: var(--color-text-muted, #9aa1af);
  }

  .pagination a {
    text-decoration: none;
    color: var(--color-primary, #6c5ce7);
    font-weight: 600;
  }
</style>
