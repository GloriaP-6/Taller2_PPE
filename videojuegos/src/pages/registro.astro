---
// Página estática (SSG). El registro real ocurre en el navegador, dentro del script de abajo.
export const prerender = true;

import Layout from '../layouts/Layout.astro';
---

<Layout title="Crear cuenta" description="Crea una cuenta para administrar el catálogo de videojuegos.">
  <div class="auth-page">
    <h1>Crear cuenta</h1>

    <form id="registro-form">
      <div>
        <label for="email">Correo</label>
        <input id="email" name="email" type="email" required autocomplete="username" />
      </div>

      <div>
        <label for="password">Contraseña</label>
        <input id="password" name="password" type="password" required minlength="6" autocomplete="new-password" />
      </div>

      <p id="error" role="alert"></p>
      <p id="exito" role="status"></p>

      <button type="submit" id="submit-btn">Crear cuenta</button>
    </form>

    <p>¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
  </div>

  <script>
    import { supabase } from '../lib/supabase';

    // Con <ClientRouter /> este script se carga una sola vez, pero la página
    // puede mostrarse muchas veces. Por eso todo va dentro de una función que
    // se ejecuta en cada "astro:page-load" (incluida la carga inicial).
    function iniciarRegistro() {
      const form = document.querySelector<HTMLFormElement>('#registro-form');
      if (!form) return; // esta página no es la que se está mostrando

      const errorEl = document.querySelector<HTMLParagraphElement>('#error')!;
      const exitoEl = document.querySelector<HTMLParagraphElement>('#exito')!;
      const submitBtn = document.querySelector<HTMLButtonElement>('#submit-btn')!;

      // Si ya hay sesión activa, no tiene sentido mostrar el registro.
      supabase.auth.getSession().then(({ data: { session } }) => {
        if (session) window.location.href = '/admin';
      });

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        errorEl.textContent = '';
        exitoEl.textContent = '';
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creando...';

        const email = (form.elements.namedItem('email') as HTMLInputElement).value;
        const password = (form.elements.namedItem('password') as HTMLInputElement).value;

        const { data, error } = await supabase.auth.signUp({ email, password });

        submitBtn.disabled = false;
        submitBtn.textContent = 'Crear cuenta';

        if (error) {
          errorEl.textContent = 'No se pudo crear la cuenta: ' + error.message;
          return;
        }

        // Si Supabase pide confirmar el correo, no llega sesión todavía.
        if (!data.session) {
          exitoEl.textContent = 'Cuenta creada. Revisa tu correo para confirmarla antes de iniciar sesión.';
          form.reset();
          return;
        }

        // Si la confirmación de correo está desactivada, ya queda logueado.
        window.location.href = '/admin';
      });
    }

    document.addEventListener('astro:page-load', iniciarRegistro);
  </script>
</Layout>

<style>
  .auth-page {
    max-width: 360px;
    margin: 0 auto;
  }

  .auth-page form div {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .auth-page label {
    font-size: 0.85rem;
    color: var(--color-text-muted, #9aa1af);
  }

  .auth-page input {
    padding: 0.6rem 0.9rem;
    border-radius: 8px;
    border: 1px solid var(--color-border, #2a2f3a);
    background: var(--color-surface, #171a21);
    color: var(--color-text, #e7e9ee);
  }

  .auth-page button[type='submit'] {
    width: 100%;
    padding: 0.65rem;
    border-radius: var(--radius, 8px);
    border: none;
    background: var(--color-primary, #ffb703);
    color: var(--color-primary-text, #12121c);
    font-weight: 700;
    cursor: pointer;
  }

  .auth-page button[type='submit']:hover {
    background: var(--color-primary-hover, #8172ef);
  }

  #error {
    color: #ff6b6b;
    min-height: 1.2em;
  }

  #exito {
    color: #51cf66;
  }
</style>
