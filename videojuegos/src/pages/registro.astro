---
export const prerender = true;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Crear cuenta · Catálogo de Videojuegos</title>
  </head>
  <body>
    <main>
      <h1>Crear cuenta</h1>

      <form id="registro-form">
        <div>
          <label for="email">Correo</label>
          <input id="email" name="email" type="email" required autocomplete="username" />
        </div>

        <div>
          <label for="password">Contraseña</label>
          <input id="password" name="password" type="password" required minlength="6" autocomplete="new-password" />
        </div>

        <p id="error" role="alert"></p>
        <p id="exito" role="status"></p>

        <button type="submit" id="submit-btn">Crear cuenta</button>
      </form>

      <p>¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
    </main>

    <script>
      import { supabase } from '../lib/supabase';

      const form = document.querySelector<HTMLFormElement>('#registro-form')!;
      const errorEl = document.querySelector<HTMLParagraphElement>('#error')!;
      const exitoEl = document.querySelector<HTMLParagraphElement>('#exito')!;
      const submitBtn = document.querySelector<HTMLButtonElement>('#submit-btn')!;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        errorEl.textContent = '';
        exitoEl.textContent = '';
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creando...';

        const email = (form.elements.namedItem('email') as HTMLInputElement).value;
        const password = (form.elements.namedItem('password') as HTMLInputElement).value;

        const { data, error } = await supabase.auth.signUp({ email, password });

        submitBtn.disabled = false;
        submitBtn.textContent = 'Crear cuenta';

        if (error) {
          errorEl.textContent = 'No se pudo crear la cuenta: ' + error.message;
          return;
        }

        // Si Supabase pide confirmar el correo, no llega sesión todavía.
        if (!data.session) {
          exitoEl.textContent = 'Cuenta creada. Revisa tu correo para confirmarla antes de iniciar sesión.';
          form.reset();
          return;
        }

        // Si la confirmación de correo está desactivada, ya queda logueado.
        window.location.href = '/admin';
      });
    </script>
  </body>
</html>
