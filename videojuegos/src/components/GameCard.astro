---
/**
 * Tarjeta reutilizable para mostrar un juego (o cualquier item con
 * nombre/imagen/categoría). Pensada para que Persona A y Persona C
 * la reutilicen en el catálogo, detalle, favoritos, etc.
 */
interface Props {
  nombre: string;
  categoria?: string | null;
  imagen?: string | null;
  href?: string;
}

const { nombre, categoria, imagen, href } = Astro.props;

const imagenSrc = imagen || '/favicon.svg';
---

<article class="game-card">
  {href ? (
    <a href={href} class="game-card__link">
      <span class="game-card__stripe" aria-hidden="true"></span>
      <img src={imagenSrc} alt={nombre} width="200" height="120" loading="lazy" />
      <div class="game-card__body">
        <h3>{nombre}</h3>
        {categoria && <span class="game-card__tag">{categoria}</span>}
      </div>
    </a>
  ) : (
    <>
      <span class="game-card__stripe" aria-hidden="true"></span>
      <img src={imagenSrc} alt={nombre} width="200" height="120" loading="lazy" />
      <div class="game-card__body">
        <h3>{nombre}</h3>
        {categoria && <span class="game-card__tag">{categoria}</span>}
      </div>
    </>
  )}
  <div class="game-card__extra">
    <slot />
  </div>
</article>

<style>
  .game-card {
    background: var(--color-surface, #1b1b2b);
    border: 1px solid var(--color-border, #33334d);
    border-radius: var(--radius, 8px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .game-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-primary, #ffb703);
  }

  .game-card__stripe {
    display: block;
    height: 4px;
    background: var(--color-primary, #ffb703);
  }

  .game-card__link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .game-card img {
    width: 100%;
    height: 140px;
    object-fit: cover;
    background: var(--color-surface-2, #242438);
  }

  .game-card__body {
    padding: 0.85rem 1rem;
  }

  .game-card__body h3 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .game-card__tag {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    color: #0a3d33;
    background: var(--color-accent-2, #06d6a0);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }

  .game-card__extra:empty {
    display: none;
  }

  .game-card__extra {
    padding: 0 1rem 0.85rem;
  }
</style>
