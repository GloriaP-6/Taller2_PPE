---
/**
 * Campo de formulario genérico y reutilizable: label + input/textarea/select.
 * Pensado para que A/C lo usen al construir formularios propios
 * (crear juego, contacto, filtros avanzados, etc.) con estilo consistente.
 */
interface Props {
  name: string;
  label: string;
  type?: 'text' | 'email' | 'number' | 'url' | 'textarea';
  value?: string;
  placeholder?: string;
  required?: boolean;
}

const {
  name,
  label,
  type = 'text',
  value = '',
  placeholder = '',
  required = false,
} = Astro.props;

const fieldId = `field-${name}`;
---

<div class="form-field">
  <label for={fieldId}>{label}</label>
  {type === 'textarea' ? (
    <textarea id={fieldId} name={name} placeholder={placeholder} required={required} rows="4">{value}</textarea>
  ) : (
    <input id={fieldId} type={type} name={name} value={value} placeholder={placeholder} required={required} />
  )}
</div>

<style>
  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .form-field label {
    font-size: 0.85rem;
    color: var(--color-text-muted, #9aa1af);
  }

  .form-field input,
  .form-field textarea {
    padding: 0.6rem 0.9rem;
    border-radius: 8px;
    border: 1px solid var(--color-border, #2a2f3a);
    background: var(--color-surface, #171a21);
    color: var(--color-text, #e7e9ee);
    font: inherit;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: 2px solid var(--color-primary, #6c5ce7);
    outline-offset: 1px;
  }
</style>
