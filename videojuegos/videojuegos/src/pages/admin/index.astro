---
// Página estática (SSG). El HTML del build no trae ningún juego,
// verificable con Ctrl+U. Todo se carga en el navegador tras confirmar la sesión.
export const prerender = true;

import Layout from '../../layouts/Layout.astro';
---

<Layout title="Administrar juegos" description="Panel protegido para crear, editar y eliminar juegos.">
  <p id="cargando">Verificando sesión...</p>

  <div id="panel" hidden>
    <header class="admin-header">
      <h1>Administrar juegos</h1>
      <button id="logout-btn">Cerrar sesión</button>
    </header>

    <section>
      <h2 id="form-title">Nuevo juego</h2>
      <form id="juego-form">
        <input type="hidden" id="juego-id" value="" />

        <div>
          <label for="nombre">Nombre</label>
          <input id="nombre" name="nombre" type="text" required />
        </div>

        <div>
          <label for="imagen">URL de la imagen</label>
          <input id="imagen" name="imagen" type="text" required placeholder="https://..." />
        </div>

        <div>
          <label for="categoria">Categoría</label>
          <input id="categoria" name="categoria" type="text" required />
        </div>

        <p id="form-error" role="alert"></p>

        <button type="submit" id="guardar-btn">Guardar</button>
        <button type="button" id="cancelar-edicion-btn" hidden>Cancelar edición</button>
      </form>
    </section>

    <section>
      <h2>Juegos existentes</h2>
      <p id="lista-error" role="alert"></p>
      <ul id="lista-juegos"></ul>
    </section>
  </div>

  <script>
    import { supabase } from '../../lib/supabase';
    import type { AuthChangeEvent, Session } from '@supabase/supabase-js';

    const cargandoEl = document.querySelector<HTMLParagraphElement>('#cargando')!;
    const panelEl = document.querySelector<HTMLDivElement>('#panel')!;
    const listaEl = document.querySelector<HTMLUListElement>('#lista-juegos')!;
    const listaErrorEl = document.querySelector<HTMLParagraphElement>('#lista-error')!;

    const form = document.querySelector<HTMLFormElement>('#juego-form')!;
    const idInput = document.querySelector<HTMLInputElement>('#juego-id')!;
    const nombreInput = document.querySelector<HTMLInputElement>('#nombre')!;
    const imagenInput = document.querySelector<HTMLInputElement>('#imagen')!;
    const categoriaInput = document.querySelector<HTMLInputElement>('#categoria')!;
    const formTitle = document.querySelector<HTMLHeadingElement>('#form-title')!;
    const formErrorEl = document.querySelector<HTMLParagraphElement>('#form-error')!;
    const guardarBtn = document.querySelector<HTMLButtonElement>('#guardar-btn')!;
    const cancelarBtn = document.querySelector<HTMLButtonElement>('#cancelar-edicion-btn')!;
    const logoutBtn = document.querySelector<HTMLButtonElement>('#logout-btn')!;

    type Juego = { id: number; nombre: string; imagen: string; categoria: string };

    // --- 1. Verificar sesión antes de mostrar nada -------------------
    async function init() {
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        window.location.href = '/login';
        return;
      }

      cargandoEl.hidden = true;
      panelEl.hidden = false;
      await cargarJuegos();
    }

    // Si la sesión cambia en otra pestaña (ej. cierre de sesión), reacciona aquí también.
    supabase.auth.onAuthStateChange((_event: AuthChangeEvent, session: Session | null) => {
      if (!session) window.location.href = '/login';
    });

    // --- 2. Listar juegos ---------------------------------------------
    async function cargarJuegos() {
      listaErrorEl.textContent = '';
      const { data, error } = await supabase
        .from('juegos')
        .select('*')
        .order('id', { ascending: true });

      if (error) {
        listaErrorEl.textContent = 'No se pudieron cargar los juegos.';
        return;
      }

      renderLista(data as Juego[]);
    }

    function renderLista(juegos: Juego[]) {
      listaEl.innerHTML = '';

      if (juegos.length === 0) {
        listaEl.innerHTML = '<li>Todavía no hay juegos.</li>';
        return;
      }

      for (const juego of juegos) {
        const li = document.createElement('li');
        li.innerHTML = `
          <img src="${juego.imagen}" alt="${juego.nombre}" width="80" />
          <strong>${juego.nombre}</strong> — ${juego.categoria}
          <button type="button" data-accion="editar" data-id="${juego.id}">Editar</button>
          <button type="button" data-accion="eliminar" data-id="${juego.id}">Eliminar</button>
        `;
        listaEl.appendChild(li);
      }

      listaEl.querySelectorAll<HTMLButtonElement>('[data-accion="editar"]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const juego = juegos.find((j) => j.id === Number(btn.dataset.id));
          if (juego) entrarModoEdicion(juego);
        });
      });

      listaEl.querySelectorAll<HTMLButtonElement>('[data-accion="eliminar"]').forEach((btn) => {
        btn.addEventListener('click', () => eliminarJuego(Number(btn.dataset.id)));
      });
    }

    // --- 3. Editar (precargar el formulario) ---------------------------
    function entrarModoEdicion(juego: Juego) {
      idInput.value = String(juego.id);
      nombreInput.value = juego.nombre;
      imagenInput.value = juego.imagen;
      categoriaInput.value = juego.categoria;
      formTitle.textContent = `Editando: ${juego.nombre}`;
      guardarBtn.textContent = 'Guardar cambios';
      cancelarBtn.hidden = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function salirModoEdicion() {
      idInput.value = '';
      form.reset();
      formTitle.textContent = 'Nuevo juego';
      guardarBtn.textContent = 'Guardar';
      cancelarBtn.hidden = true;
    }

    cancelarBtn.addEventListener('click', salirModoEdicion);

    // --- 4. Crear o actualizar (según si hay id) ------------------------
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      formErrorEl.textContent = '';
      guardarBtn.disabled = true;

      const payload = {
        nombre: nombreInput.value.trim(),
        imagen: imagenInput.value.trim(),
        categoria: categoriaInput.value.trim(),
      };

      const editandoId = idInput.value;
      const { error } = editandoId
        ? await supabase.from('juegos').update(payload).eq('id', editandoId)
        : await supabase.from('juegos').insert(payload);

      guardarBtn.disabled = false;

      if (error) {
        // Si las políticas RLS no están bien configuradas, este es el error que vas a ver.
        formErrorEl.textContent = 'No se pudo guardar: ' + error.message;
        return;
      }

      salirModoEdicion();
      await cargarJuegos();
    });

    // --- 5. Eliminar ------------------------------------------------------
    async function eliminarJuego(id: number) {
      if (!confirm('¿Eliminar este juego? Esta acción no se puede deshacer.')) return;

      const { error } = await supabase.from('juegos').delete().eq('id', id);
      if (error) {
        listaErrorEl.textContent = 'No se pudo eliminar: ' + error.message;
        return;
      }
      await cargarJuegos();
    }

    // --- 6. Logout ----------------------------------------------------------
    logoutBtn.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/';
    });

    init();
  </script>

  <style>
    .admin-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    #juego-form div {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      margin-bottom: 1rem;
      max-width: 420px;
    }

    #juego-form label {
      font-size: 0.85rem;
      color: var(--color-text-muted, #9aa1af);
    }

    #juego-form input {
      padding: 0.6rem 0.9rem;
      border-radius: 8px;
      border: 1px solid var(--color-border, #2a2f3a);
      background: var(--color-surface, #171a21);
      color: var(--color-text, #e7e9ee);
    }

    #guardar-btn,
    #logout-btn,
    #cancelar-edicion-btn {
      padding: 0.5rem 1rem;
      border-radius: var(--radius, 8px);
      border: 1px solid var(--color-border, #33334d);
      background: var(--color-primary, #ffb703);
      color: var(--color-primary-text, #12121c);
      font-weight: 700;
      cursor: pointer;
    }

    #cancelar-edicion-btn {
      background: transparent;
      color: var(--color-text, #f1f1f6);
      margin-left: 0.5rem;
    }

    #lista-juegos {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    #lista-juegos li {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: var(--color-surface, #171a21);
      border: 1px solid var(--color-border, #2a2f3a);
      border-radius: 8px;
      padding: 0.5rem 0.75rem;
    }

    #error,
    #form-error,
    #lista-error {
      color: #ff6b6b;
      min-height: 1.2em;
    }
  </style>
</Layout>
