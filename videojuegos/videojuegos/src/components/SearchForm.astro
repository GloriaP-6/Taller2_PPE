---
/**
 * Formulario de búsqueda reutilizable (GET). Ideal para el catálogo
 * y cualquier otra página que necesite filtrar por texto.
 */
interface Props {
  action?: string;
  name?: string;
  value?: string;
  placeholder?: string;
  label?: string;
}

const {
  action = '/',
  name = 'q',
  value = '',
  placeholder = 'Buscar por nombre...',
  label = 'Buscar',
} = Astro.props;
---

<form method="GET" action={action} class="search-form" role="search">
  <label for={`search-${name}`} class="sr-only">{label}</label>
  <input
    id={`search-${name}`}
    type="text"
    name={name}
    value={value}
    placeholder={placeholder}
    autocomplete="off"
  />
  <button type="submit">{label}</button>
</form>

<style>
  .search-form {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .search-form input {
    flex: 1;
    padding: 0.6rem 0.9rem;
    border-radius: 8px;
    border: 1px solid var(--color-border, #2a2f3a);
    background: var(--color-surface, #171a21);
    color: var(--color-text, #e7e9ee);
  }

  .search-form input:focus {
    outline: 2px solid var(--color-primary, #6c5ce7);
    outline-offset: 1px;
  }

  .search-form button {
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius, 8px);
    border: none;
    background: var(--color-primary, #ffb703);
    color: var(--color-primary-text, #12121c);
    font-weight: 700;
    cursor: pointer;
  }

  .search-form button:hover {
    background: var(--color-primary-hover, #8172ef);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
